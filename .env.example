SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Required. The API will not start without this, and will not fall back to a default secret.
JWT_SECRET=replace-with-a-long-random-string

# Note: platform admin JWTs use the same JWT_SECRET with scope=platform_admin.
# There is no separate PLATFORM_JWT_SECRET.

# Required. 32-byte key used only to encrypt integration secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must NOT be the same value as JWT_SECRET.
INTEGRATION_ENCRYPTION_KEY=replace-with-64-hex-characters

# Public HTTPS URL of THIS API (webhooks + OAuth). Required in production.
# Aliases also accepted: PUBLIC_BASE_URL, API_PUBLIC_BASE_URL
# Development:
APP_PUBLIC_BASE_URL=http://localhost:5050
# Production example (do not guess; use your real API domain):
# APP_PUBLIC_BASE_URL=https://api.example.com

# Server-controlled EasyOrders Admin API origin. Company credentials cannot override host.
# Default (if unset): https://api.easy-orders.net/api/v1/external-apps
# EASYORDERS_API_BASE_URL=https://api.easy-orders.net/api/v1/external-apps

# Browser CORS allowlist (comma-separated HTTPS origins). Required in production. No wildcards.
# Include the Company Dashboard origin and Super Admin origin.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Trust the first reverse-proxy hop for HTTPS / rate-limit client IPs.
# Production defaults to trust proxy = 1.
# TRUST_PROXY=1

# Login: 10 attempts / 15 minutes / IP (in-memory; shared store needed for multi-instance).
# LOGIN_RATE_MAX=10
# LOGIN_RATE_WINDOW_MS=900000
# PLATFORM_LOGIN_RATE_MAX=10
# Signup: 5 attempts / hour / IP
# SIGNUP_RATE_MAX=5
# SIGNUP_RATE_WINDOW_MS=3600000
# Token-only webhooks: 300 / minute / IP
# WEBHOOK_RATE_MAX=300

# Shopify Admin GraphQL API version. Backend-controlled; not a company setting.
SHOPIFY_ADMIN_API_VERSION=2026-07

# Salla Partner App OAuth (platform credentials, never company settings).
# SALLA_OAUTH_CLIENT_ID=replace-with-salla-partner-app-client-id
# SALLA_OAUTH_CLIENT_SECRET=replace-with-salla-partner-app-client-secret
# Must match Partner App redirect URI exactly:
# SALLA_OAUTH_REDIRECT_URI=https://api.example.com/api/integrations/salla/oauth/callback
# SALLA_OAUTH_STATE_SECRET=replace-with-a-long-random-state-hmac-secret
# SALLA_APP_WEBHOOK_SECRET=replace-with-salla-app-webhook-secret
# Partner App lifecycle webhook: POST {APP_PUBLIC_BASE_URL}/webhooks/salla/app

# Public Super Admin origin used after Salla OAuth callback.
# PLATFORM_ADMIN_PUBLIC_BASE_URL=https://admin.example.com

# Shopify canonical dual-write (backend-only). OFF by default.
# CATALOG_DUAL_WRITE_SHOPIFY=false
# CATALOG_DUAL_WRITE_COMPANY_IDS=

# Cloud hosts usually inject PORT. Local default is 5050.
# PORT=5050

# development | test | production
NODE_ENV=development

# One-time platform admin bootstrap (scripts/bootstrap-platform-admin.js) — never commit values:
# PLATFORM_ADMIN_EMAIL=ops@example.com
# PLATFORM_ADMIN_PASSWORD=replace-with-long-random-password
# PLATFORM_ADMIN_NAME=Platform Ops
