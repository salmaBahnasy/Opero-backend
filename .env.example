SUPABASE_URL=SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY

# Required. The API will not start without this, and will not fall back to a default secret.
JWT_SECRET=replace-with-a-long-random-string

# Required. 32-byte key used only to encrypt integration secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must NOT be the same value as JWT_SECRET.
INTEGRATION_ENCRYPTION_KEY=replace-with-64-hex-characters

# Public URL used when generating Super Admin webhook URLs.
APP_PUBLIC_BASE_URL=http://localhost:5050

# development | test | production
NODE_ENV=development
